# ─── Neon (Student Portal runtime database) ───────────────────────────────────
# Get from: console.neon.tech → your project → Connection string
# Use the pooled connection string (includes ?sslmode=require)
DATABASE_URL=

# ─── Supabase (Course Builder) ────────────────────────────────────────────────
# Get from: supabase.com → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Auth.js (Student Portal auth) ────────────────────────────────────────────
# Generate: openssl rand -base64 32
AUTH_SECRET=
# Google OAuth: console.cloud.google.com → Credentials
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ─── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── ElevenLabs ───────────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=

# ─── Inngest ──────────────────────────────────────────────────────────────────
# Get from: app.inngest.com → your app → Manage → Keys
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ─── Hosting (domain routing) ─────────────────────────────────────────────────
# Override for local dev if needed; defaults shown
# BUILDER_HOSTNAME=builder.localhost
# DASHBOARD_HOSTNAME=dashboard.localhost
